# Market data provider: "demo" (default, no key needed) | "alphavantage" | "alpaca"
MARKET_DATA_PROVIDER=demo
ALPHAVANTAGE_API_KEY=
# "delayed" is honest for a free-tier key (no realtime entitlement).
# Only set "realtime" if your Alpha Vantage plan actually has that entitlement.
ALPHAVANTAGE_ENTITLEMENT=delayed

# Alpaca (real-time IEX bars). Get free keys at https://alpaca.markets
# IEX is a single exchange (~2-3% of volume), NOT the consolidated tape —
# the app labels this "LIVE • IEX", never "full market".
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Comma separated tickers to monitor
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA,TSLA,META,AMD,NFLX,JPM
# Refresh interval seconds for live loop
REFRESH_INTERVAL_SECONDS=15
